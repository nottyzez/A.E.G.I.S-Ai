# Copy to .env and fill in. Never commit the real file.
#   cp deploy/digitalocean/.env.example deploy/digitalocean/.env
#   chmod 600 deploy/digitalocean/.env

# Bearer token for the control plane. With AEGIS_REQUIRE_AUTH=1 every mutating
# request (pump/dose/schedule/calibration/cam) needs it. The dashboard asks for
# it once in a browser prompt after its first 401 and remembers it in that
# browser's localStorage. Make it long and random, not a word.
CONTROL_TOKEN=

# Reserved: the ESP32 sketches do not send this yet, so nothing enforces it.
DEVICE_API_KEY=

# 1 = require CONTROL_TOKEN on every browser-facing write. Set 1 on a public
# droplet; 0 is only safe on the lab LAN. Auth on with an empty CONTROL_TOKEN
# fails closed (every write is 401), it does not fall open.
AEGIS_REQUIRE_AUTH=1

# Copy to .env and fill in. Never commit the real file.

# Shared secret the dashboard sends as X-Control-Token on pump commands.
CONTROL_TOKEN=change-me-presenter-pin

# Shared secret the ESP32-S3 main board and ESP32-CAM send as X-Device-Api-Key.
DEVICE_API_KEY=change-me-device-key

# 1 = reject unauthenticated pump commands. Until the cloud broker lands this
# flag is read by nothing; keep it 0 so the LAN dashboard keeps working.
AEGIS_REQUIRE_AUTH=0
